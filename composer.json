{
    "name": "systemira/standard",
    "type": "project",
    "description": "Standard Laravel starter: admin dashboard + API, roles & permissions, settings, notifications.",
    "keywords": [
        "framework",
        "laravel",
        "starter"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3.6",
        "barryvdh/laravel-translation-manager": "^0.6.8",
        "darkaonline/l5-swagger": "*",
        "doctrine/dbal": "^3.8",
        "firebase/php-jwt": "^7.0",
        "guzzlehttp/guzzle": "^7.8",
        "intervention/image": "^3.11",
        "jenssegers/agent": "^2.6",
        "kreait/firebase-php": "^7.16",
        "laravel/framework": "^13.0",
        "laravel/helpers": "^1.7",
        "laravel/pulse": "^1.8",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.5",
        "lcobucci/jwt": "^5.2",
        "php-open-source-saver/jwt-auth": "^2.2",
        "propaganistas/laravel-phone": "^6.0",
        "pusher/pusher-php-server": "^7.2",
        "rap2hpoutre/fast-excel": "*",
        "santigarcor/laratrust": "^8.5",
        "spatie/laravel-activitylog": "^4.11",
        "spatie/laravel-html": "^3.12",
        "symfony/var-dumper": "^7.2",
        "twilio/sdk": "^8.11"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.3",
        "spatie/laravel-ignition": "^2.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "wikimedia/composer-merge-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/request_context.php",
            "app/Helpers/form_options.php",
            "app/Helpers/labels.php",
            "app/Helpers/admin_navigation.php",
            "app/Helpers/countries.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
