APP_NAME=Standard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=standard
DB_USERNAME=root
DB_PASSWORD=

# Seeded by database/seeders/AdminUserSeeder.php — change before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password


BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120


QUEUE_CONNECTION=sync

LARATRUST_ENABLE_CACHE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Social login (token verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_REDIRECT=
FACEBOOK_REDIRECT=
APPLE_CLIENT_ID=

FIREBASE_CREDENTIALS=

# SMS provider: twilio | vonage | kwtsms
SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=
KWTSMS_USERNAME=
KWTSMS_PASSWORD=
KWTSMS_SENDER=
