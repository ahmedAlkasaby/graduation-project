APP_NAME=Standard
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=standard
DB_USERNAME=root
DB_PASSWORD=

# Seeded by database/seeders/AdminUserSeeder.php — change before deploying.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=password


BROADCAST_CONNECTION=log
CACHE_STORE=file
FILESYSTEM_DISK=local
SESSION_DRIVER=file
SESSION_LIFETIME=120


QUEUE_CONNECTION=sync

LARATRUST_ENABLE_CACHE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# JWT (php-open-source-saver/jwt-auth) — run: php artisan jwt:secret
JWT_SECRET=

# Broadcasting
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Socialite
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_REDIRECT=
FACEBOOK_REDIRECT=
APPLE_CLIENT_ID=

FIREBASE_CREDENTIALS=

# SMS provider: twilio | vonage | kwtsms
SMS_PROVIDER=twilio
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_FROM=
KWTSMS_USERNAME=
KWTSMS_PASSWORD=
KWTSMS_SENDER=


PULSE_ENABLED=true
PULSE_PATH=admin/pulse

PULSE_INGEST_DRIVER=storage
PULSE_STORAGE_KEEP="7 days"

# Recorders
PULSE_ENDPOINT_METRICS_ENABLED=true
PULSE_ENDPOINT_METRICS_SAMPLE_RATE=1
PULSE_CACHE_INTERACTIONS_ENABLED=true
PULSE_CACHE_INTERACTIONS_SAMPLE_RATE=1
PULSE_EXCEPTIONS_ENABLED=true
# No queued work in this app (QUEUE_CONNECTION=sync, no app/Jobs).
PULSE_QUEUES_ENABLED=false
PULSE_SLOW_JOBS_ENABLED=false
PULSE_USER_JOBS_ENABLED=false
PULSE_HIGH_MEMORY_REQUESTS_ENABLED=true
PULSE_HIGH_MEMORY_REQUESTS_SAMPLE_RATE=1
PULSE_HIGH_BANDWIDTH_REQUESTS_ENABLED=true
PULSE_HIGH_BANDWIDTH_REQUESTS_SAMPLE_RATE=1
PULSE_MEMORY_HEAVY_QUERIES_ENABLED=true
PULSE_MEMORY_HEAVY_QUERIES_SAMPLE_RATE=1

# Thresholds (ms)
PULSE_SLOW_REQUESTS_THRESHOLD=500
PULSE_SLOW_QUERIES_THRESHOLD=5000
PULSE_SLOW_OUTGOING_REQUESTS_THRESHOLD=1000

# Thresholds (MB peak memory / KB transferred / MB allocated per query)
PULSE_HIGH_MEMORY_REQUESTS_THRESHOLD=100
PULSE_HIGH_BANDWIDTH_REQUESTS_THRESHOLD=1000
PULSE_MEMORY_HEAVY_QUERIES_THRESHOLD=10
