                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users",
                    "{{userId}}",
                    "restore"
                  ]
                },
                "description": "Needs `users.restore`. Restores a soft-deleted user.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            }
          ]
        },
        {
          "name": "Roles",
          "item": [
            {
              "name": "List roles",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
