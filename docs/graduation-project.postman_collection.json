                      "description": "Name or display name"
                    },
                    {
                      "key": "all_data",
                      "value": "1",
                      "disabled": true,
                      "description": "1 = paginated (default), 0 = everything unpaginated"
                    }
                  ]
                },
                "description": "Needs `roles.index`. Only roles whose permissions you all hold are listed (super admin sees all).",
