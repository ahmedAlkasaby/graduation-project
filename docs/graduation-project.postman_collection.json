{
  "info": {
    "name": "Graduation Project API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register - check email (sends code)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "lang",
                "value": "{{lang}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/register/check",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "public",
                "register",
                "check"
              ]
            },
            "description": "Checks the email/phone are free and emails a verification code.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@example.com\",\n  \"phone\": \"01012345678\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "lang",
                "value": "{{lang}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "public",
                "register"
              ]
            },
            "description": "type: donor | volunteer. Saves access/refresh tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Ahmed Donor\",\n  \"email\": \"donor@example.com\",\n  \"phone\": \"01012345678\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\",\n  \"code\": \"1234\",\n  \"type\": \"donor\",\n  \"locale\": \"en\",\n  \"imei\": \"{{imei}}\",\n  \"token\": \"firebase-device-token\",\n  \"device_type\": \"android\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "lang",
                "value": "{{lang}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "public",
                "login"
              ]
            },
            "description": "`email` also accepts a phone number. Saves access/refresh tokens.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"donor@example.com\",\n  \"password\": \"password123\",\n  \"imei\": \"{{imei}}\",\n  \"token\": \"firebase-device-token\",\n  \"device_type\": \"android\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Social login",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "lang",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/social_login?provider=google&token=social-provider-token&imei={{imei}}&device_type=android&firebase_token=firebase-device-token&type=donor",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "public",
                "social_login"
              ],
              "query": [
                {
                  "key": "provider",
                  "value": "google"
                },
                {
                  "key": "token",
                  "value": "social-provider-token"
                },
                {
                  "key": "imei",
                  "value": "{{imei}}"
                },
                {
                  "key": "device_type",
                  "value": "android"
                },
                {
                  "key": "firebase_token",
                  "value": "firebase-device-token"
                },
                {
                  "key": "type",
                  "value": "donor"
                }
              ]
            },
            "description": "provider: google | facebook | apple. device_type: mobile only."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "lang",
                "value": "{{lang}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/public/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "public",
                "refresh"
              ]
            },
            "description": "Send the REFRESH token as bearer. The old pair is revoked.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{refreshToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('accessToken', json.data.access_token);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
