    {
      "name": "Admin",
      "description": "Dashboard management. Sign in with an admin or super admin account first (Auth > Login). Each request needs the permission named in its description; a super admin skips every check.",
      "item": [
        {
          "name": "Users",
          "item": [
            {
              "name": "List users",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users?page=1",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "1",
                      "disabled": false,
                      "description": "Page number"
                    },
                    {
                      "key": "limit",
                      "value": "10",
                      "disabled": true,
                      "description": "1-100"
                    },
                    {
                      "key": "search",
                      "value": "",
                      "disabled": true,
                      "description": "Name, email or phone"
                    },
                    {
                      "key": "type",
                      "value": "all",
                      "disabled": true,
                      "description": "donor | volunteer | admin | super_admin | all"
                    },
                    {
                      "key": "active",
                      "value": "1",
                      "disabled": true,
                      "description": "1 or 0"
                    },
                    {
                      "key": "trashed",
                      "value": "with",
                      "disabled": true,
                      "description": "with | only (soft-deleted users)"
                    },
                    {
                      "key": "date_start",
                      "value": "2026-01-01",
                      "disabled": true,
                      "description": "Created from (Y-m-d)"
                    },
                    {
                      "key": "date_end",
                      "value": "2026-12-31",
                      "disabled": true,
                      "description": "Created to (Y-m-d), >= date_start"
                    },
                    {
                      "key": "all_data",
                      "value": "1",
                      "disabled": true,
                      "description": "1 = paginated (default), 0 = everything unpaginated"
                    }
                  ]
                },
                "description": "Needs `users.index`. Response `permissions` tells the dashboard which buttons to show.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "Form options",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users/form-options",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users",
                    "form-options"
                  ]
                },
                "description": "The choices the create/edit form needs (types, roles...). Needs `users.store` or `users.update`.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "Create user",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users"
                  ]
                },
                "description": "Needs `users.store`. `roles` is only kept for `type=admin`. `email` is required for admin types. You can only create types at or below your own rank. To upload `image`, switch the body to form-data. Saves the new id to `userId`.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"full_name\": \"Sara Ahmed\",\n  \"type\": \"admin\",\n  \"roles\": [\n    1\n  ],\n  \"email\": \"sara.admin@example.com\",\n  \"phone\": \"01012345678\",\n  \"password\": \"password123\",\n  \"confirm_password\": \"password123\",\n  \"active\": true,\n  \"is_notify\": true,\n  \"locale\": \"en\",\n  \"gender\": \"female\",\n  \"birth_date\": \"1998-05-20\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "const json = pm.response.json();",
                      "if (json.data && json.data.user && json.data.user.id) {",
                      "  pm.collectionVariables.set('userId', json.data.user.id);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Show user",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users",
                    "{{userId}}"
                  ]
                },
                "description": "Needs `users.show`.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "Update user",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  },
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users",
                    "{{userId}}"
                  ]
                },
                "description": "Needs `users.update`. `password` is optional here; send it with `confirm_password` to change it.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                },
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"full_name\": \"Sara Ahmed Updated\",\n  \"type\": \"admin\",\n  \"roles\": [\n    1\n  ],\n  \"email\": \"sara.admin@example.com\",\n  \"phone\": \"01012345678\",\n  \"active\": true,\n  \"is_notify\": true,\n  \"locale\": \"en\",\n  \"gender\": \"female\",\n  \"birth_date\": \"1998-05-20\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              }
            },
            {
              "name": "Toggle user status",
              "request": {
                "method": "PATCH",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}/status",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users",
                    "{{userId}}",
                    "status"
                  ]
                },
                "description": "Needs `users.status`. Flips `active`; no body.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
            },
            {
              "name": "Delete user",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "key": "lang",
                    "value": "{{lang}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/users/{{userId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "users",
                    "{{userId}}"
                  ]
                },
                "description": "Needs `users.destroy`. Soft delete; bring it back with Restore.",
                "auth": {
                  "type": "bearer",
                  "bearer": [
                    {
                      "key": "token",
                      "value": "{{accessToken}}",
                      "type": "string"
                    }
                  ]
                }
              }
