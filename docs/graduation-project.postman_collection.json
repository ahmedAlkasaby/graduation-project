                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/admin/roles?page=1",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "v1",
                    "admin",
                    "roles"
                  ],
                  "query": [
                    {
                      "key": "page",
                      "value": "1",
                      "disabled": false,
                      "description": "Page number"
                    },
                    {
                      "key": "limit",
                      "value": "10",
                      "disabled": true,
                      "description": "1-100"
                    },
                    {
                      "key": "search",
                      "value": "",
