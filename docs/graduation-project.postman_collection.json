              "path": [
                "api",
                "v1",
                "public",
                "profile",
                "permissions"
              ]
            },
            "description": "Which dashboard sidebar items the signed in user may open, as `is_*` true/false flags. A super admin gets every flag `true`. No permission needed, only a valid access token.",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
