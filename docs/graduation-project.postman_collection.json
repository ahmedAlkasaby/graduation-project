                  "raw": "{\n  \"name\": \"content_editor\",\n  \"display_name\": \"Content Editor\",\n  \"description\": \"Manages users only\",\n  \"permissions\": [\n    1,\n    2\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
